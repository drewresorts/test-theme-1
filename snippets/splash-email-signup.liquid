{% comment %}
  Email signup for splash-streams email_signup blocks.

  signup_type:
  - shopify: native newsletter (AJAX + hCaptcha token; stays on splash)
  - embed: custom HTML — no Shopify captcha
  - external_link: external URL — no Shopify captcha

  Accepts:
  - block: {Object} email_signup block
  - section: {Object} splash-streams section
{% endcomment %}

{%- liquid
  assign signup_heading = block.settings.heading | strip
  assign signup_text = block.settings.text
  assign signup_placeholder = block.settings.placeholder | default: 'Email' | strip
  assign signup_button = block.settings.button_label | default: 'Subscribe' | strip
  assign signup_type = block.settings.signup_type | default: 'shopify'
  assign captcha_on_splash = block.settings.captcha_on_splash | default: 'inline'
  if captcha_on_splash == 'inline'
    assign show_disclaimer = true
  else
    assign show_disclaimer = block.settings.show_spam_disclaimer
  endif
  assign lowercase_class = ''
  if block.settings.lowercase_text
    assign lowercase_class = ' splash-streams__signup--lowercase'
  endif

  assign return_to_path = request.path
  if return_to_path == blank
    assign return_to_path = '/'
  endif

  if block.settings.success_message != blank
    assign signup_success_text = block.settings.success_message
  else
    assign signup_success_text = 'splash_streams.email.success' | t
  endif
-%}

<div
  class="splash-streams__email-signup{{ lowercase_class }}"
  {% if signup_type == 'shopify' %}
    data-splash-email-root
    data-splash-email-block-id="{{ block.id }}"
    data-splash-email-captcha-mode="{{ captcha_on_splash }}"
    {% if form.posted_successfully? %}
      data-splash-email-just-success
    {% endif %}
  {% endif %}
>
  {%- if signup_heading != blank -%}
    <p class="splash-streams__signup-heading">{{ signup_heading | escape }}</p>
  {%- endif -%}

  {%- if signup_text != blank -%}
    <div class="splash-streams__signup-text rte">{{ signup_text }}</div>
  {%- endif -%}

  {%- case signup_type -%}
    {%- when 'embed' -%}
      {%- if block.settings.embed_code != blank -%}
        <div class="splash-streams__email-embed">
          {{ block.settings.embed_code }}
        </div>
      {%- endif -%}

    {%- when 'external_link' -%}
      {%- if block.settings.external_url != blank -%}
        <div class="splash-streams__email-external">
          <a
            class="splash-streams__email-field__button splash-streams__email-external-link"
            href="{{ block.settings.external_url }}"
            {% if block.settings.external_new_tab %}
              target="_blank"
              rel="noopener noreferrer"
            {% endif %}
          >
            {{ signup_button | escape }}
          </a>
        </div>
      {%- endif -%}

    {%- else -%}
      <div
        class="splash-streams__email-form-panel"
        data-splash-email-form-panel
        {% if form.posted_successfully? %}
          hidden
        {% endif %}
      >
        {%- assign splash_email_form_id = 'SplashEmail-' | append: block.id -%}
        {%- if captcha_on_splash == 'inline' -%}
          {% form 'customer', class: 'splash-streams__email-form', id: splash_email_form_id, data-shopify-captcha: 'true' %}
        {%- else -%}
          {% form 'customer', class: 'splash-streams__email-form', id: splash_email_form_id %}
        {%- endif -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="hidden" name="return_to" value="{{ return_to_path | escape }}">
          <div class="splash-streams__email-field">
            <input
              id="SplashEmailInput-{{ block.id }}"
              class="splash-streams__email-field__input"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="{{ signup_placeholder | escape }}"
              required
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="SplashEmailError-{{ block.id }}"
              {% endif %}
            >
            <button
              type="submit"
              class="splash-streams__email-field__button"
              name="commit"
              aria-label="{{ signup_button | escape }}"
            >
              {{ signup_button | escape }}
            </button>
          </div>

          {%- if show_disclaimer -%}
            <p class="splash-streams__email-disclaimer">
              {{ 'shopify.online_store.spam_detection.disclaimer_html' | t }}
            </p>
          {%- endif -%}

          {%- if captcha_on_splash == 'inline' -%}
            <div
              class="splash-streams__email-captcha-panel"
              data-splash-email-captcha-panel
              hidden
            >
              <p class="splash-streams__email-captcha-heading">
                {{ 'splash_streams.email.captcha_heading' | t }}
              </p>
              <div class="splash-streams__email-captcha-mount" data-splash-email-captcha-mount></div>
              <iframe
                class="splash-streams__email-challenge-frame"
                data-splash-email-challenge-frame
                title="{{ 'splash_streams.email.captcha_frame_title' | t }}"
                hidden
              ></iframe>
              <button
                type="button"
                class="splash-streams__email-captcha-retry"
                data-splash-email-challenge-retry
                hidden
              >
                {{ 'splash_streams.email.captcha_retry' | t }}
              </button>
            </div>
          {%- endif -%}

          <p
            class="splash-streams__email-message splash-streams__email-message--error"
            data-splash-email-error
            role="alert"
            hidden
          ></p>

          {%- if form.errors -%}
            <p class="splash-streams__email-message splash-streams__email-message--error" id="SplashEmailError-{{ block.id }}" role="alert">
              {%- if form.errors.messages.email != blank -%}
                {{ form.errors.messages.email }}
              {%- else -%}
                {{ 'splash_streams.email.error' | t }}
              {%- endif -%}
            </p>
          {%- endif -%}
        {% endform %}
      </div>

      <div
        class="splash-streams__email-success-panel"
        data-splash-email-success-panel
        {% unless form.posted_successfully? %}
          hidden
        {% endunless %}
      >
        <p
          class="splash-streams__email-message splash-streams__email-message--success splash-streams__email-message--standalone"
          id="SplashEmailSuccess-{{ block.id }}"
          role="status"
          tabindex="-1"
        >
          {{ signup_success_text | escape }}
        </p>
      </div>
  {%- endcase -%}
</div>
