<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.background_color | default: '#0b0b0f' }}">
    <meta name="referrer" content="strict-origin-when-cross-origin">

    <title>
      {%- if page_title != blank -%}
        {{ page_title }} &middot; {{ shop.name }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </title>

    {%- if page_description != blank -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.stream_origin != blank -%}
      <link rel="preconnect" href="{{ settings.stream_origin }}" crossorigin>
    {%- endif -%}

    {{ content_for_header }}

    {% style %}
      :root {
        color-scheme: dark;
        --font-body-family: {{ settings.body_font.family | default: 'system-ui' }}, {{ settings.body_font.fallback_families | default: 'sans-serif' }};
      }
      html, body { margin: 0; padding: 0; background: {{ settings.background_color | default: '#0b0b0f' }}; color: {{ settings.text_color | default: '#ffffff' }}; }
      body { font-family: var(--font-body-family); -webkit-font-smoothing: antialiased; }
      img, video { max-width: 100%; display: block; }
      .theme-frame { position: relative; z-index: 1; isolation: isolate; min-height: 100svh; }
      *, *::before, *::after { box-sizing: border-box; }
      a { color: inherit; }
      :focus-visible { outline: 2px solid {{ settings.text_color | default: '#ffffff' }}; outline-offset: 2px; }
    {% endstyle %}

    {% if settings.body_font %}
      {{ settings.body_font | font_face: font_display: 'swap' }}
    {% endif %}
  </head>
  <body class="template-{{ template | replace: '.', '-' | handle }}">
    <a class="visually-hidden" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% section 'site-stream-backdrop' %}

    <div class="theme-frame">
      <main id="MainContent" role="main">
        {{ content_for_layout }}
      </main>
    </div>

    {% style %}
      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
        border: 0;
      }
    {% endstyle %}
  </body>
</html>
